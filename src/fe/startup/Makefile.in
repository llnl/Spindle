	$(top_builddir)/../utils/$(am__dirstamp) \
	$(top_builddir)/../utils/$(DEPDIR)/$(am__dirstamp)

libconfigparse.a: $(libconfigparse_a_OBJECTS) $(libconfigparse_a_DEPENDENCIES) $(EXTRA_libconfigparse_a_DEPENDENCIES) 
	$(AM_V_at)-rm -f libconfigparse.a
	$(AM_V_AR)$(libconfigparse_a_AR) libconfigparse.a $(libconfigparse_a_OBJECTS) $(libconfigparse_a_LIBADD)
	$(AM_V_at)$(RANLIB) libconfigparse.a
