#!/bin/bash
#
# spindle-podman - Consolidated CLI for Spindle podman operations
#
# Usage: ./spindle-podman <command> [options]
#
# This replaces the scattered collection of build/test/cleanup scripts
# with a single entry point that tracks state and provides visibility.

set -euo pipefail

# Determine repo root
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STATE_FILE="$REPO_ROOT/.podman-state.json"
METRICS_LOG="$REPO_ROOT/.podman-metrics.log"
LOG_DIR="$REPO_ROOT/.podman-logs"

# Colors for output
if [[ -t 1 ]]; then
    GREEN='\033[0;32m'
    YELLOW='\033[1;33m'
    RED='\033[0;31m'
    BLUE='\033[0;34m'
    BOLD='\033[1m'
    RESET='\033[0m'
else
    GREEN='' YELLOW='' RED='' BLUE='' BOLD='' RESET=''
fi

# Source common podman utilities
# shellcheck source=scripts/podman/env.sh disable=SC1091
source "$REPO_ROOT/scripts/podman/env.sh"
# shellcheck source=scripts/podman/common.sh disable=SC1091
source "$REPO_ROOT/scripts/podman/common.sh"
# shellcheck source=scripts/podman/targets.sh
source "$REPO_ROOT/scripts/podman/targets.sh"

# Where `save` and `load` keep the images: shared storage, outside the repo (and the build context).
IMAGE_TARBALL="${SPINDLE_PODMAN_IMAGES:-$(cd "$REPO_ROOT/../.." && pwd)/tmp/podman-images/spindle-images.tar}"

#==============================================================================
# Target Registry Helpers (data lives in scripts/podman/targets.sh)
#==============================================================================

is_target() {
    local t
    for t in "${TARGETS[@]}"; do
        [[ "$t" == "$1" ]] && return 0
    done
    return 1
}

target_list() {
    local IFS='|'
    echo "${TARGETS[*]}"
}

testable_list() {
    local IFS='|' t out=()
    for t in "${TARGETS[@]}"; do
        [[ -n "${T_TEST[$t]:-}" ]] && out+=("$t")
    done
    echo "${out[*]}"
}

image_exists() {
    podman images --format "{{.Repository}}" 2>/dev/null | grep -q "^localhost/$1\$"
}

# The image a target produces: a built one lives under localhost/, a pulled one keeps its reference.
image_ref() {
    local t="$1"
    if [[ -n "${T_PULL[$t]:-}" ]]; then
        printf '%s\n' "${T_PULL[$t]}"
    else
        printf 'localhost/%s:latest\n' "${T_IMAGE[$t]}"
    fi
}

target_image_exists() {
    local t="$1"
    if [[ -n "${T_PULL[$t]:-}" ]]; then
        podman image exists "${T_PULL[$t]}" 2>/dev/null
    else
        image_exists "${T_IMAGE[$t]}"
    fi
}

# Fills BUILD_CMD with the podman build command for target $1.
build_command() {
    local t="$1"
    if [[ -n "${T_PULL[$t]:-}" ]]; then
        BUILD_CMD=(podman pull "${T_PULL[$t]}")
        return 0
    fi
    local context="$REPO_ROOT/${T_CONTEXT[$t]:-}"
    context="${context%/}"
    # T_BUILD_ARGS and LC_CERT_BUILD_MOUNT are intentionally word-split.
    # shellcheck disable=SC2206
    BUILD_CMD=(podman build --build-arg "PODMAN_BUILD=true" $LC_CERT_BUILD_MOUNT ${T_BUILD_ARGS[$t]:-}
               -t "${T_IMAGE[$t]}" -f "$REPO_ROOT/${T_DOCKERFILE[$t]}" "$context")
}

#==============================================================================
# State Management
#==============================================================================

init_state() {
    if [[ ! -f "$STATE_FILE" ]]; then
        cat > "$STATE_FILE" <<'EOF'
{
  "version": "1.0",
  "images": {},
  "tests": {},
  "background_jobs": {}
}
EOF
    fi
}

get_state() {
    local key="$1"
    jq -r "$key // empty" "$STATE_FILE" 2>/dev/null || echo ""
}

update_state() {
    local key="$1"
    local value="$2"
    local tmp
    tmp=$(mktemp)
    # Remove leading dot and split by dot to create path array
    local cleaned_key="${key#.}"
    jq --arg k "$cleaned_key" --argjson v "$value" 'setpath($k | split("."); $v)' "$STATE_FILE" > "$tmp"
    mv "$tmp" "$STATE_FILE"
}

#==============================================================================
# Logging and Metrics
#==============================================================================

log_metric() {
    local operation="$1"
    local target="$2"
    local duration="$3"
    local status="$4"

    mkdir -p "$(dirname "$METRICS_LOG")"
    printf '%s,%s,%s,%s,%s\n' \
        "$(date -Iseconds)" \
        "$operation" \
        "$target" \
        "$duration" \
        "$status" >> "$METRICS_LOG"
}

log_dir_for_run() {
    local run_id
    run_id="$(date +%Y%m%d-%H%M%S)"
    echo "$LOG_DIR/$run_id"
}

#==============================================================================
# Status Command
#==============================================================================

cmd_status() {
    local verbose=false

    if [[ "${1:-}" == "--verbose" ]] || [[ "${1:-}" == "-v" ]]; then
        verbose=true
    fi

    init_state

    echo -e "${BOLD}=== Spindle Podman Status ===${RESET}\n"

    # Check podman availability
    if command -v podman &>/dev/null; then
        echo -e "${GREEN}✓${RESET} Podman available: $(podman --version | head -1)"
    else
        echo -e "${RED}✗${RESET} Podman not found"
        return 1
    fi

    # Check images
    echo -e "\n${BOLD}Images:${RESET}"
    local has_images=false

    for target in "${TARGETS[@]}"; do
        local image_name missing="not built"
        image_name=$(image_ref "$target")
        [[ -n "${T_PULL[$target]:-}" ]] && missing="not pulled"

        if target_image_exists "$target"; then
            has_images=true
            local image_id size created
            image_id=$(podman images --format "{{.ID}}" "$image_name" 2>/dev/null | head -1)
            size=$(podman images --format "{{.Size}}" "$image_name" 2>/dev/null | head -1)
            created=$(podman images --format "{{.CreatedAt}}" "$image_name" 2>/dev/null | head -1)

            echo -e "  ${GREEN}✓${RESET} ${BOLD}$target${RESET}: $size (created: $created)"

            if $verbose; then
                echo "      Image: $image_name"
                echo "      Image ID: $image_id"
            fi
        else
            echo -e "  ${YELLOW}○${RESET} $target: $missing"
        fi
    done

    if ! $has_images; then
        echo -e "  ${YELLOW}No images built yet${RESET}"
    fi

    echo -e "\n${BOLD}Image tarball:${RESET}"
    if [[ -f "$IMAGE_TARBALL" ]]; then
        echo "  $IMAGE_TARBALL: $(human_bytes "$(stat -c %s "$IMAGE_TARBALL")"), saved $(date -r "$IMAGE_TARBALL" "+%Y-%m-%d %H:%M")"
    else
        echo "  none yet ($IMAGE_TARBALL); create with: $0 save"
    fi

    # Check running containers
    echo -e "\n${BOLD}Running Containers:${RESET}"
    local container_count
    container_count=$(podman ps --format "{{.Names}}" 2>/dev/null | grep -cE "spindle|slurm" || true)

    if [[ $container_count -gt 0 ]]; then
        podman ps --filter "name=spindle" --filter "name=slurm" --format "table {{.Names}}\t{{.Status}}\t{{.Ports}}" 2>/dev/null
    else
        echo "  None"
    fi

    # Check test status
    echo -e "\n${BOLD}Test Status:${RESET}"
    local last_test_target last_test_status last_test_time
    last_test_target=$(get_state '.tests | keys | .[-1]')

    if [[ -n "$last_test_target" ]]; then
        last_test_status=$(get_state ".tests[\"$last_test_target\"].status")
        last_test_time=$(get_state ".tests[\"$last_test_target\"].last_run")
        local passed failed
        passed=$(get_state ".tests[\"$last_test_target\"].passed")
        failed=$(get_state ".tests[\"$last_test_target\"].failed")

        if [[ "$last_test_status" == "passed" ]]; then
            echo -e "  ${GREEN}✓${RESET} ${BOLD}$last_test_target${RESET}: $passed passed, $failed failed"
        else
            echo -e "  ${RED}✗${RESET} ${BOLD}$last_test_target${RESET}: $last_test_status"
        fi
        echo "      Last run: $last_test_time"
    else
        echo "  No tests run yet"
    fi

    # Check logs
    if [[ -d "$LOG_DIR" ]]; then
        local log_count
        log_count=$(find "$LOG_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l)
        if [[ $log_count -gt 0 ]]; then
            echo -e "\n${BOLD}Logs:${RESET} $log_count sessions in $LOG_DIR"
            if $verbose; then
                echo "  Recent sessions:"
                find "$LOG_DIR" -mindepth 1 -maxdepth 1 -type d | sort -r | head -3 | while read -r dir; do
                    echo "    $(basename "$dir")"
                done
            fi
        fi
    fi

    echo ""
}

#==============================================================================
# Build Command
#==============================================================================

# Runs the pre-step (if any) and the podman build for one target.
# With dry_run=true, prints what would run instead.
run_build() {
    local t="$1"
    local dry_run="${2:-false}"
    local prestep="${T_PRESTEP[$t]:-}"

    if [[ -n "$prestep" ]]; then
        echo "+ (cd $REPO_ROOT && $prestep)"
        if ! $dry_run; then
            (cd "$REPO_ROOT" && eval "$prestep") || return 1
        fi
    fi

    build_command "$t"
    printf '+'
    printf ' %q' "${BUILD_CMD[@]}"
    echo
    if ! $dry_run; then
        "${BUILD_CMD[@]}"
    fi
}

cmd_build() {
    local target="${1:-}"
    local background=false
    local dry_run=false

    if [[ -z "$target" ]]; then
        echo "Error: build target required"
        echo "Usage: $0 build <$(target_list)> [--background] [--dry-run]"
        return 1
    fi
    shift

    if ! is_target "$target"; then
        echo -e "${RED}Error:${RESET} Unknown target '$target'"
        echo "Available targets: $(target_list)"
        return 1
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --background|-b) background=true; shift ;;
            --dry-run|-n) dry_run=true; shift ;;
            *) echo "Unknown option: $1"; return 1 ;;
        esac
    done

    if [[ -z "${T_PULL[$target]:-}" && ! -f "$REPO_ROOT/${T_DOCKERFILE[$target]:-}" ]]; then
        echo -e "${RED}Error:${RESET} Dockerfile not found: $REPO_ROOT/${T_DOCKERFILE[$target]:-<unset>}"
        return 1
    fi

    $dry_run || init_state

    local prereq
    for prereq in ${T_PREREQ[$target]:-}; do
        if $dry_run; then
            echo "# prerequisite '$prereq' (only if its image is missing):"
            cmd_build "$prereq" --dry-run || return 1
        elif target_image_exists "$prereq"; then
            echo -e "${GREEN}✓${RESET} $prereq image already present\n"
        else
            echo -e "${YELLOW}→${RESET} $prereq image not found, getting it first...\n"
            if ! cmd_build "$prereq"; then
                echo -e "${RED}✗${RESET} Failed to get $prereq image"
                return 1
            fi
            echo ""
        fi
    done

    if $dry_run; then
        echo "# build $target:"
        run_build "$target" true
        return 0
    fi

    echo -e "${BOLD}Building $target...${RESET}\n"

    local start_time
    start_time=$(date +%s)
    local log_dir
    log_dir=$(log_dir_for_run)
    mkdir -p "$log_dir"
    local log_file="$log_dir/build-${target}.log"

    if $background; then
        echo "Starting background build..."
        echo "Log: $log_file"

        run_build "$target" > "$log_file" 2>&1 &
        local pid=$!

        echo "Background job PID: $pid"
        echo -e "${BLUE}→${RESET} Use '$0 status' to check progress"

        update_state "background_jobs.build-${target}" \
            "{\"pid\": $pid, \"started\": \"$(date -Iseconds)\", \"log\": \"$log_file\"}"

        return 0
    fi

    local rc=0
    run_build "$target" 2>&1 | tee "$log_file" || rc=$?

    local duration=$(( $(date +%s) - start_time ))

    if [[ $rc -ne 0 ]]; then
        echo -e "\n${RED}✗${RESET} Build failed after ${duration}s"
        echo "Log: $log_file"
        log_metric "build" "$target" "${duration}s" "failed"
        return 1
    fi

    echo -e "\n${GREEN}✓${RESET} Build completed in ${duration}s"
    log_metric "build" "$target" "${duration}s" "success"
    update_state "images.$target" \
        "{\"built\": \"$(date -Iseconds)\", \"build_time_sec\": $duration}"

    local baseline="${T_BASELINE[$target]:-}"
    if [[ -n "$baseline" && $duration -gt $baseline ]]; then
        echo -e "${YELLOW}⚠${RESET}  Build time (${duration}s) exceeded baseline (${baseline}s)"
    fi
    return 0
}

#==============================================================================
# Test Command
#==============================================================================

cmd_test() {
    local target="${1:-}"
    local repeat=1
    local background=false
    local script_args=()

    if [[ -z "$target" ]]; then
        echo "Error: test target required"
        echo "Usage: $0 test <$(testable_list)> [--repeat N] [--background] [--id N] [--keep] [--debug N] [--timeout S]"
        return 1
    fi
    shift

    if ! is_target "$target" || [[ -z "${T_TEST[$target]:-}" ]]; then
        echo -e "${RED}Error:${RESET} No tests for target '$target'"
        echo "Testable targets: $(testable_list)"
        return 1
    fi

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repeat|-r) repeat="$2"; shift 2 ;;
            --background|-b) background=true; shift ;;
            --id) script_args=("${2:?--id needs a number}"); shift 2 ;;
            --keep) export CLUSTER_KEEP=1; shift ;;
            --debug) export SPINDLE_DEBUG="${2:?--debug needs a level}"; shift 2 ;;
            --timeout) export CLUSTER_TEST_TIMEOUT="${2:?--timeout needs seconds}"; shift 2 ;;
            *) echo "Unknown option: $1"; return 1 ;;
        esac
    done

    init_state

    local test_script="$REPO_ROOT/${T_TEST[$target]}"
    export SPINDLE_PODMAN_TARGET="$target"

    if [[ ! -f "$test_script" ]]; then
        echo -e "${RED}Error:${RESET} Test script not found: $test_script"
        return 1
    fi

    if ! target_image_exists "$target"; then
        echo -e "${RED}Error:${RESET} Image '$(image_ref "$target")' not found"
        echo "Build it first with: $0 build $target"
        return 1
    fi

    echo -e "${BOLD}Testing $target...${RESET}\n"

    local start_time
    start_time=$(date +%s)
    local log_dir
    log_dir=$(log_dir_for_run)
    mkdir -p "$log_dir"
    export SPINDLE_PODMAN_LOG_DIR="$log_dir"
    local log_file="$log_dir/test-${target}.log"

    if $background; then
        echo "Starting background test..."
        echo "Log: $log_file"

        bash "$test_script" ${script_args[@]+"${script_args[@]}"} > "$log_file" 2>&1 &
        local pid=$!

        echo "Background job PID: $pid"
        echo -e "${BLUE}→${RESET} Use '$0 status' to check results"

        update_state "background_jobs.test-${target}" \
            "{\"pid\": $pid, \"started\": \"$(date -Iseconds)\", \"log\": \"$log_file\"}"

        return 0
    else
        local success=true

        for ((i=1; i<=repeat; i++)); do
            if [[ $repeat -gt 1 ]]; then
                echo -e "${BOLD}Run $i of $repeat${RESET}"
            fi

            if bash "$test_script" ${script_args[@]+"${script_args[@]}"} 2>&1 | tee -a "$log_file"; then
                if [[ $repeat -gt 1 ]]; then
                    echo -e "${GREEN}✓${RESET} Run $i passed\n"
                fi
            else
                echo -e "${RED}✗${RESET} Run $i failed\n"
                success=false
                break
            fi
        done

        local end_time duration
        end_time=$(date +%s)
        duration=$((end_time - start_time))

        if $success; then
            echo -e "\n${GREEN}✓${RESET} All tests passed in ${duration}s"

            log_metric "test" "$target" "${duration}s" "passed"

            # Parse test output for counts (looking for "ALL TESTS PASSED")
            local passed failed
            if grep -q "ALL TESTS PASSED" "$log_file"; then
                passed=$(grep -c "^Running:" "$log_file" || true)
                failed=0
            else
                passed=0
                failed=1
            fi

            update_state "tests.$target" \
                "{\"last_run\": \"$(date -Iseconds)\", \"status\": \"passed\", \"duration_sec\": $duration, \"passed\": $passed, \"failed\": $failed, \"log\": \"$log_file\"}"

            return 0
        else
            echo -e "\n${RED}✗${RESET} Tests failed after ${duration}s"
            echo "Log: $log_file"

            log_metric "test" "$target" "${duration}s" "failed"

            update_state "tests.$target" \
                "{\"last_run\": \"$(date -Iseconds)\", \"status\": \"failed\", \"duration_sec\": $duration, \"log\": \"$log_file\"}"

            return 1
        fi
    fi
}

# Removes the networks the test scripts create (<prefix>-<id>-net).  $1 = force.
remove_test_networks() {
    local force="$1" prefix network
    for prefix in "${KNOWN_NETWORK_PREFIXES[@]}"; do
        while read -r network; do
            [[ -n "$network" ]] || continue
            echo "  Removing network: $network"
            if [[ "$force" == true ]]; then
                podman network rm -f "$network" >/dev/null 2>&1 || true
            else
                podman network rm "$network" >/dev/null 2>&1 || true
            fi
        done < <(podman network ls --format '{{.Name}}' 2>/dev/null | grep "^${prefix}-")
    done
}

# The cluster helper starts one aardvark-dns by hand (see scripts/podman/cluster.sh); stop it
# when nothing is left using it.
stop_dns_server() {
    if pgrep -u "$(id -u)" -x aardvark-dns >/dev/null 2>&1; then
        echo "Stopping aardvark-dns"
        pkill -u "$(id -u)" -x aardvark-dns 2>/dev/null || true
    fi
}

#==============================================================================
# Cleanup Command
#==============================================================================

cmd_cleanup() {
    local force=false

    if [[ "${1:-}" == "--force" ]] || [[ "${1:-}" == "-f" ]]; then
        force=true
    fi

    echo -e "${BOLD}Cleaning up Spindle podman resources...${RESET}\n"

    # Stop running containers (both spindle* and slurm-*)
    local containers
    containers=$(podman ps -a --format "{{.Names}}" 2>/dev/null | grep -E "spindle|slurm" || true)

    if [[ -n "$containers" ]]; then
        echo "Stopping containers..."
        echo "$containers" | while read -r container; do
            if $force; then
                echo "  Force removing: $container"
                timeout 2 podman rm -f "$container" 2>/dev/null || true
            else
                echo "  Stopping: $container"
                if ! timeout 10 podman stop "$container" 2>/dev/null; then
                    echo "    Timeout, force removing..."
                    podman rm -f "$container" 2>/dev/null || true
                fi
            fi
        done
        echo -e "${GREEN}✓${RESET} Containers cleaned\n"
    else
        echo "No running containers to clean"
    fi

    echo "Cleaning up networks..."
    remove_test_networks false
    stop_dns_server

    # Clean up dangling resources
    echo "Cleaning dangling resources..."
    podman container prune -f 2>/dev/null || true

    echo -e "\n${GREEN}✓${RESET} Cleanup complete"
}

cmd_defenestrate() {
    echo -e "${RED}${BOLD}Nuclear cleanup - killing everything!${RESET}\n"

    # Kill all spindle and slurm containers immediately
    podman ps -a --format "{{.Names}}" 2>/dev/null | grep -E "spindle|slurm" | while read -r container; do
        echo "Killing: $container"
        podman rm -f "$container" 2>/dev/null || true
    done

    remove_test_networks true
    stop_dns_server

    # Prune everything
    podman container prune -f 2>/dev/null || true
    podman network prune -f 2>/dev/null || true

    echo -e "\n${GREEN}✓${RESET} All resources destroyed"
}

#==============================================================================
# Save / Load Commands
#==============================================================================
# Image storage is node-local (/var/tmp), so images vanish with an allocation.  save writes them
# to one tarball on the shared filesystem; load reads it back on a new node.

# Total size in bytes of the named images (0 for any that cannot be inspected).
images_size_bytes() {
    local total=0 img sz
    for img in "$@"; do
        sz=$(podman image inspect --format '{{.Size}}' "$img" 2>/dev/null || true)
        [[ "$sz" =~ ^[0-9]+$ ]] || sz=0
        total=$((total + sz))
    done
    echo "$total"
}

human_bytes() {
    awk -v b="$1" 'BEGIN { split("B KB MB GB TB", u); i = 1; while (b >= 1024 && i < 5) { b /= 1024; i++ } printf "%.1f %s", b, u[i] }'
}

cmd_save() {
    local dry_run=false force=false dest="$IMAGE_TARBALL"
    local targets=() images=() skipped=() t

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run|-n) dry_run=true; shift ;;
            --force|-f)   force=true; shift ;;
            --output|-o)  dest="${2:-}"; shift 2 || true ;;
            -*) echo "Unknown option: $1"; return 1 ;;
            *)  targets+=("$1"); shift ;;
        esac
    done
    [[ -n "$dest" ]] || { echo "Error: --output needs a path"; return 1; }
    [[ ${#targets[@]} -gt 0 ]] || targets=("${TARGETS[@]}")

    for t in "${targets[@]}"; do
        is_target "$t" || { echo -e "${RED}Error:${RESET} Unknown target '$t'"; echo "Available targets: $(target_list)"; return 1; }
        if target_image_exists "$t"; then
            images+=("$(image_ref "$t")")
        else
            skipped+=("$t")
        fi
    done

    if [[ ${#skipped[@]} -gt 0 ]]; then
        echo -e "${YELLOW}Not saved (image not present on this node):${RESET} ${skipped[*]}"
    fi
    if [[ ${#images[@]} -eq 0 ]]; then
        echo -e "${RED}Error:${RESET} none of the requested images exist on this node"
        return 1
    fi

    # The limit applies to the tarball as it is written, not to a prediction: image sizes counted
    # per image include shared layers again and again (5 images summed to 9.2 GB; the tarball was ~4 GB).
    local limit_gb="${SAVE_MAX_GB:-12}"
    local sum limit prev=0
    sum=$(images_size_bytes "${images[@]}")
    limit=$(awk -v g="$limit_gb" 'BEGIN { printf "%d", g * 1073741824 }')
    [[ -f "$dest" ]] && prev=$(stat -c %s "$dest")
    echo "Images to save:"
    printf '  %s\n' "${images[@]}"
    echo "Sum of image sizes: $(human_bytes "$sum")  (shared layers are counted once per image; the tarball stores them once)"
    echo "Destination:        $dest"
    if (( prev > 0 )); then
        echo "Existing tarball:   $(human_bytes "$prev"), replaced only if this save succeeds"
    fi
    echo "Size limit:         ${limit_gb} GB for the tarball itself (SAVE_MAX_GB; --force disables it)"

    local part="$dest.partial.$$"
    local cmd=(podman save --multi-image-archive -o "$part" "${images[@]}")
    if $dry_run; then
        printf '+'; printf ' %q' "${cmd[@]}"; echo
        echo "+ mv $part $dest"
        return 0
    fi

    mkdir -p "$(dirname "$dest")"
    local start=$SECONDS spid rc=0 exceeded=false size=0
    "${cmd[@]}" &
    spid=$!
    # shellcheck disable=SC2064  # $spid and $part are fixed for this save
    trap "kill $spid 2>/dev/null; rm -f -- '$part'; trap - INT TERM; echo; echo 'save interrupted; the existing tarball is untouched'; return 130" INT TERM

    while kill -0 "$spid" 2>/dev/null; do
        sleep 1
        size=$(stat -c %s "$part" 2>/dev/null || echo 0)
        if (( size > limit )) && ! $force; then
            exceeded=true
            kill "$spid" 2>/dev/null
            break
        fi
    done
    # spindle-podman runs under `set -e`: a nonzero status from wait must not end the script here.
    wait "$spid" 2>/dev/null || rc=$?
    trap - INT TERM

    if $exceeded; then
        rm -f -- "$part"
        echo -e "${RED}✗${RESET} Stopped: the tarball passed ${limit_gb} GB ($(human_bytes "$size") written) and was still growing."
        echo "  The partial file was removed and the existing tarball is untouched."
        echo "  Check 'podman images' for strays.  If this size is expected: SAVE_MAX_GB=<n> or --force."
        log_metric "save" "images" "$((SECONDS - start))s" "failed"
        return 1
    fi
    if (( rc != 0 )); then
        rm -f -- "$part"
        echo -e "${RED}✗${RESET} podman save failed (status $rc)"
        log_metric "save" "images" "$((SECONDS - start))s" "failed"
        return 1
    fi
    mv -f -- "$part" "$dest"

    local bytes secs=$((SECONDS - start))
    bytes=$(stat -c %s "$dest")
    echo -e "${GREEN}✓${RESET} Saved ${#images[@]} images to $dest: $(human_bytes "$bytes") in ${secs}s"
    if (( prev > 0 && bytes * 2 > prev * 3 )); then
        echo -e "${YELLOW}⚠${RESET}  The tarball is more than 1.5x the previous one ($(human_bytes "$prev")).  Expected if images were added."
    fi
    if (( bytes > limit )); then
        echo -e "${YELLOW}⚠${RESET}  Tarball exceeds ${limit_gb} GB (allowed by --force)"
    fi
    log_metric "save" "images" "${secs}s" "success"
}

cmd_load() {
    local dry_run=false in="$IMAGE_TARBALL"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --dry-run|-n) dry_run=true; shift ;;
            --input|-i)   in="${2:-}"; shift 2 || true ;;
            *) echo "Unknown option: $1"; return 1 ;;
        esac
    done
    [[ -n "$in" ]] || { echo "Error: --input needs a path"; return 1; }

    if [[ ! -f "$in" ]]; then
        echo -e "${RED}Error:${RESET} no tarball at $in"
        echo "Create one on a node that has the images with: $0 save"
        return 1
    fi

    local bytes
    bytes=$(stat -c %s "$in")
    echo "Loading $in ($(human_bytes "$bytes"))"
    if $dry_run; then
        echo "+ podman load -i $in"
        return 0
    fi

    local start=$SECONDS
    if ! podman load -i "$in"; then
        echo -e "${RED}✗${RESET} podman load failed"
        log_metric "load" "images" "$((SECONDS - start))s" "failed"
        return 1
    fi
    local secs=$((SECONDS - start)) t
    echo -e "${GREEN}✓${RESET} Loaded in ${secs}s"
    log_metric "load" "images" "${secs}s" "success"

    for t in "${TARGETS[@]}"; do
        if target_image_exists "$t"; then
            echo -e "  ${GREEN}✓${RESET} $t"
        else
            echo -e "  ${YELLOW}○${RESET} $t: not in the tarball"
        fi
    done
}

cmd_env() {
    echo "export XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR"
    echo "# eval \"\$($0 env)\" to give another shell the same podman state directory"
}

#==============================================================================
# Logs Command
#==============================================================================

cmd_logs() {
    local count="${1:-5}"

    if [[ ! -d "$LOG_DIR" ]]; then
        echo "No logs directory found"
        return 0
    fi

    echo -e "${BOLD}Recent log sessions (last $count):${RESET}\n"

    find "$LOG_DIR" -mindepth 1 -maxdepth 1 -type d | sort -r | head -n "$count" | while read -r dir; do
        local session
        session=$(basename "$dir")
        echo -e "${BOLD}$session${RESET}"

        while read -r log; do
            local log_name size
            log_name=$(basename "$log")
            size=$(du -h "$log" | cut -f1)

            if grep -qi "error\|failed" "$log" 2>/dev/null; then
                echo -e "  ${RED}✗${RESET} $log_name ($size) - contains errors"
            else
                echo -e "  ${GREEN}✓${RESET} $log_name ($size)"
            fi
        done < <(find "$dir" -name "*.log" -type f | sort)
        echo ""
    done

    echo "Log directory: $LOG_DIR"
}

#==============================================================================
# Help
#==============================================================================

cmd_diagnose() {
    local what="${1:-}"
    shift || true
    case "$what" in
        dns)
            # probe-dns.sh creates a throwaway network and two containers; see its header.
            bash "$REPO_ROOT/scripts/podman/probe-dns.sh" "$@"
            ;;
        ssh)
            # probe-ssh.sh runs sshd in a throwaway container, with and without the uid maps.
            bash "$REPO_ROOT/scripts/podman/probe-ssh.sh" "$@"
            ;;
        hang|snapshot)
            # A fresh shell: the cluster helpers are not written to run under `set -e`.
            bash -c 'source "$1/scripts/podman/cluster.sh"; cluster_snapshot "$2" "" diagnose' _ "$REPO_ROOT" "${1:-slurm-srun-1}"
            ;;
        ""|help)
            help_diagnose
            ;;
        *)
            echo "Unknown diagnose topic: $what"
            help_diagnose
            return 1
            ;;
    esac
}

#==============================================================================
# Help
#==============================================================================

help_status() {
    cat <<'EOF'
spindle-podman status [--verbose|-v]

  Show which images are built, which containers are running, the last test result per target,
  the image tarball, and how many log sessions exist.  Reads local state only; changes nothing.
EOF
}

help_build() {
    cat <<'EOF'
spindle-podman build <target> [--background|-b] [--dry-run|-n]

  Build the container image for <target> (see Targets), or for a pulled target (mariadb) pull
  it.  A target's prerequisites are fetched first when their images are missing.  Output goes to
  .podman-logs/<run>/build-<target>.log.
  A build slower than the target's baseline prints a warning (baselines are in targets.sh).

  --dry-run, -n     Print the exact commands, prerequisite included, and run nothing.
  --background, -b  Build in the background; progress is in the log file.
EOF
}

help_test() {
    cat <<'EOF'
spindle-podman test <target> [options]

  Run the testsuite for <target> in containers and record the result (status shows it).
  Cluster targets bring up a Slurm cluster, run the tests, and tear it down, always.
  Extra container options for a target (uid maps for rshlaunch) are T_RUN_ARGS in targets.sh;
  CLUSTER_RUN_ARGS in the environment overrides them, even when empty.

  --repeat N, -r N  Run N times; stop at the first failure.
  --background, -b  Run in the background.
  --id N            Name the cluster slurm-srun-N, so several runs can coexist (default 1).
  --keep            Leave the cluster running afterwards (sets CLUSTER_KEEP=1).
  --debug N         Run Spindle at SPINDLE_DEBUG=N; debug logs are collected on a hang.
  --timeout S       Declare a hang when no new test has started for S seconds (default 600;
                    0 disables).  Then a snapshot is taken and the run aborted (exit 124).

  Needs the target's image and, for cluster targets, the mariadb image on this node
  (see: build mariadb, save, load).  Output goes to .podman-logs/<run>/test-<target>.log.
EOF
}

help_cleanup() {
    cat <<'EOF'
spindle-podman cleanup [--force|-f]

  Stop and remove every container whose name contains "spindle" or "slurm", remove the test
  networks, prune stopped containers, and stop aardvark-dns.  Gentle by default (10 s per
  container); --force skips the wait.  Containers that no longer answer (see: diagnose hang)
  can ignore this; defenestrate is the blunt tool.
EOF
}

help_defenestrate() {
    cat <<'EOF'
spindle-podman defenestrate

  Remove all spindle/slurm containers immediately, remove the test networks, prune networks
  and stop aardvark-dns.  No waiting.  Use when cleanup is stuck.
EOF
}

help_logs() {
    cat <<'EOF'
spindle-podman logs [N]

  List the last N (default 5) log sessions under .podman-logs/ with their sizes and whether they
  mention errors.  Snapshots from hung runs are in snapshot-* directories there.
EOF
}

help_save() {
    cat <<'EOF'
spindle-podman save [target...] [--dry-run|-n] [--force|-f] [--output|-o PATH]

  Save images into ONE tarball on shared storage, so a new node can `load` them instead of
  rebuilding (about 15 minutes).  With no targets, saves every image present on this node,
  built or pulled.  Images not present are skipped and listed.

  The tarball is written under a temporary name and renamed on success, so a failed or
  interrupted save leaves the existing tarball untouched.  While it is written, the file's size
  is watched: past SAVE_MAX_GB (default 12, decimals allowed) the save is stopped and the partial
  file removed, unless --force.  A tarball once grew to hundreds of GB unnoticed.  It warns when
  the result is more than 1.5x the previous tarball.  (The "sum of image sizes" it prints counts
  shared layers once per image and is only a hint; the tarball is far smaller.)

  Default path: $SPINDLE_PODMAN_IMAGES, else <workspace>/tmp/podman-images/spindle-images.tar
EOF
}

help_load() {
    cat <<'EOF'
spindle-podman load [--dry-run|-n] [--input|-i PATH]

  Load the tarball made by `save` into this node's (node-local) image storage, then list which
  targets are now present.  Run it first on every new allocation.
EOF
}

help_env() {
    cat <<'EOF'
spindle-podman env

  Print `export XDG_RUNTIME_DIR=...`.  podman keeps per-container state under that directory;
  spindle-podman pins it to a fixed node-local path (see scripts/podman/env.sh).  A podman
  command typed by hand in another shell must use the same one, or exec/stop/rm on running
  containers can fail:

      eval "$(./spindle-podman env)"
EOF
}

help_diagnose() {
    cat <<'EOF'
spindle-podman diagnose <topic> [args]

  dns                 Create a throwaway network and two containers and test, layer by layer,
                      whether container names resolve (IP routing, the resolver, aardvark-dns,
                      names, the /etc/hosts fallback).  PROBE_TIMEOUT=N sets seconds per check.
                      Needs the slurm-base image (or pass another image name).
  ssh                 Start sshd in a throwaway container and log in to it, with podman's default
                      id mapping and again with the extra uid/gid maps (uid/gid 65534) that the
                      rshlaunch target uses.  Shows which one works.  Needs the slurm-base image.
  hang [prefix]       Collect evidence from a cluster that looks stuck (default slurm-srun-1):
                      processes with kernel wait channels, sockets, slurm state, Spindle debug
                      logs, gdb backtraces, podman/crun state.  Passwords are redacted.
                      Written to .podman-logs/snapshot-<prefix>-<time>/.  Run it from a shell
                      with the same environment as the one that started the cluster
                      (eval "$(./spindle-podman env)"); a test started with `test` takes this
                      snapshot by itself when it hangs.  Needs a test run with --keep to still exist.
EOF
}

help_command() {
    case "${1:-}" in
        status|st)          help_status ;;
        build|b)            help_build ;;
        test|t)             help_test ;;
        cleanup|clean)      help_cleanup ;;
        defenestrate|nuke)  help_defenestrate ;;
        logs|log)           help_logs ;;
        save)               help_save ;;
        load)               help_load ;;
        env)                help_env ;;
        diagnose)           help_diagnose ;;
        *) echo "No help for '$1'.  Commands: status build test cleanup defenestrate logs save load env diagnose"
           return 1 ;;
    esac
}

show_help() {
    if [[ -n "${1:-}" ]]; then
        help_command "$1"
        return
    fi
    cat <<'EOF'
spindle-podman - build and test Spindle in rootless podman containers

Usage:
  spindle-podman <command> [options]
  spindle-podman help <command>         details, options and environment for one command

Commands:
  status             Show images, containers, test results, tarball
  build <target>     Build a container image
  test <target>      Run the testsuite in containers
  save               Save images to a tarball on shared storage
  load               Load that tarball on a new node
  diagnose <topic>   dns / ssh: probe the container network and sshd; hang: evidence from a stuck cluster
  env                Print the XDG_RUNTIME_DIR export, for podman commands typed by hand
  logs [N]           Show recent log sessions
  cleanup            Remove containers and networks (gentle)
  defenestrate       Remove everything, immediately

Typical workflows:
  First time on a node, nothing built (about 15 minutes):
      ./spindle-podman build slurm-srun       # first gets mariadb and slurm-base, if missing
      ./spindle-podman save                   # so the next node can skip all of this
      ./spindle-podman test slurm-srun

  New allocation, tarball already saved:
      ./spindle-podman load
      ./spindle-podman test slurm-srun

  A test hangs or fails:
      ./spindle-podman test slurm-srun --keep --debug 3      # a hang is detected and snapshotted
      ./spindle-podman logs                                  # find snapshot-* directories
      ./spindle-podman diagnose hang                         # on a cluster left running by --keep
      ./spindle-podman cleanup                               # when finished

  Checking a change to the build recipe without building:
      ./spindle-podman build slurm-srun --dry-run

Targets:
EOF
    local t suffix
    for t in "${TARGETS[@]}"; do
        suffix=""
        if [[ -n "${T_PULL[$t]:-}" ]]; then
            suffix=" (pulled, not built)"
        elif [[ -z "${T_TEST[$t]:-}" ]]; then
            suffix=" (build only)"
        fi
        printf '  %-12s  %s%s\n' "$t" "${T_DESC[$t]}" "$suffix"
    done
    cat <<'EOF'

Environment (each is also described under the command that uses it):
  SPINDLE_PODMAN_IMAGES        tarball path for save/load
  SAVE_MAX_GB                  save stops if the tarball grows past this many GB (default 12)
  SPINDLE_PODMAN_RUNTIME_DIR   where podman keeps runtime state (default /var/tmp/$USER/xdg-runtime)
  CLUSTER_WORKERS              Slurm workers per cluster (default 4)
  CLUSTER_KEEP=1               leave the cluster running after a test (same as test --keep)
  CLUSTER_TEST_TIMEOUT         seconds without a new test before a hang is declared (default 600)
  CLUSTER_MARIADB_IMAGE        database image (default: the mariadb target's reference)
  SPINDLE_DEBUG=N              Spindle debug level in the testsuite (same as test --debug)
  PROBE_TIMEOUT                seconds per check in diagnose dns (default 5)
  CLUSTER_RUN_ARGS             extra podman run options for the Slurm containers (default: the target's)

Files:
  .podman-state.json   what is built and the last results      .podman-metrics.log  timings
  .podman-logs/        one directory per run, plus snapshot-*  scripts/podman/targets.sh  targets
EOF
}

#==============================================================================
# Main
#==============================================================================

main() {
    local command="${1:-help}"

    case "$command" in
        status|st)
            shift
            cmd_status "$@"
            ;;
        build|b)
            shift
            cmd_build "$@"
            ;;
        test|t)
            shift
            cmd_test "$@"
            ;;
        cleanup|clean)
            shift
            cmd_cleanup "$@"
            ;;
        defenestrate|nuke)
            shift
            cmd_defenestrate "$@"
            ;;
        logs|log)
            shift
            cmd_logs "$@"
            ;;
        save)
            shift
            cmd_save "$@"
            ;;
        load)
            shift
            cmd_load "$@"
            ;;
        env)
            cmd_env
            ;;
        diagnose|diag)
            shift
            cmd_diagnose "$@"
            ;;
        help|--help|-h)
            shift
            show_help "$@"
            ;;
        *)
            echo "Unknown command: $command"
            echo ""
            show_help
            return 1
            ;;
    esac
}

# Check for required tools
for tool in podman jq; do
    if ! command -v "$tool" &>/dev/null; then
        echo "Error: Required tool '$tool' not found"
        exit 1
    fi
done

main "$@"
